{
  "name": "next-scriptc",
  "version": "0.0.0",
  "description": "Compile Next.js route.native.ts handlers to native binaries",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "next-scriptc": "./src/cli.mjs"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "dependencies": {
    "scriptc": "0.4.6"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:shim": "node --test shim/test/parity.mjs shim/test/vercel-ipc.mjs"
  },
  "files": [
    "src",
    "shim/*.ts",
    "shim/README.md"
  ],
  "engines": {
    "node": ">=24"
  }
}
