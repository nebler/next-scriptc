{
  "name": "next-scriptc",
  "version": "0.0.0",
  "description": "Compile Next.js route.native.ts handlers and use native functions to native executables",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "bin": {
    "next-scriptc": "./src/cli.mjs"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "dependencies": {
    "scriptc": "0.4.6"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:shim": "node --test shim/test/parity.mjs shim/test/vercel-ipc.mjs",
    "test:unit": "node --test --test-skip-pattern=\"Node/native dispatcher parity|grouped build drops prerenders|discovery exports, Next extensions\" test/*.mjs"
  },
  "files": [
    "src",
    "shim/*.ts",
    "shim/README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebler/next-scriptc.git",
    "directory": "packages/next-scriptc"
  },
  "homepage": "https://github.com/nebler/next-scriptc#readme",
  "bugs": {
    "url": "https://github.com/nebler/next-scriptc/issues"
  },
  "keywords": [
    "nextjs",
    "next",
    "scriptc",
    "native",
    "typescript",
    "vercel",
    "app-router"
  ],
  "license": "Apache-2.0"
}
